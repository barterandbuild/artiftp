{
  "name": "artiftp",
  "version": "0.1.0",
  "private": true,
  "description": "ArtiFTP MVP \u2014 short-lived, owner-approved agent access to a jailed folder",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "mcp": "tsx mcp/index.ts",
    "dogfood": "tsx scripts/dogfood.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "basic-ftp": "^6.2.1",
    "better-sqlite3": "^11.9.1",
    "express": "^4.21.2",
    "nanoid": "^5.1.5",
    "ssh2-sftp-client": "^12.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/ssh2-sftp-client": "^9.0.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

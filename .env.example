PORT=8787
# Envelope master key: base64 of 32 random bytes. Required on Railway / production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ARTIFTP_MASTER_KEY=
# Retired: ARTIFTP_SECRET / AGENTFTP_SECRET (single-key encrypt). Re-enter site passwords after deploy.
OWNER_EMAIL=hello@barterandbuild.com
# Resend transactional email for owner-login, approve magic links, and waitlist.
# Leave RESEND_API_KEY unset for local/dev — links still print to the console.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=ArtiFTP <noreply@artiftp.com>
# EMAIL_FROM defaults to noreply@artiftp.com (Name <email> form is allowed).
# Public origin for magic/approve links. Required on Railway (e.g. https://app.artiftp.com).
# LOCAL: leave unset — falls back to http://127.0.0.1:8787
# PUBLIC_BASE_URL=https://app.artiftp.com
# Legacy alias if PUBLIC_BASE_URL is unset:
BASE_URL=http://127.0.0.1:8787
# Force mock FS even for real hosts (dogfood / offline)
# ARTIFTP_FORCE_MOCK=1
# Legacy alias supported: AGENTFTP_FORCE_MOCK=1
